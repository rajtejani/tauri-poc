{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline First Hub Tauri",
  "version": "1.0.0",
  "identifier": "com.offlinefirst.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Offline First Hub",
        "width": 2000,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0f172a",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline-first LAN sync hub (Tauri)",
    "longDescription": "Parity build of Offline First Hub for Electron vs Tauri performance comparison.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}