# Preview the bottom-left update toast without publishing a real release:
#   npm run updater:preview
# or open http://localhost:1420/?previewUpdateToast=1
VITE_PREVIEW_UPDATE_TOAST=false

# Signing is read from the environment (Tauri does NOT load .env for this).
# For local signed builds, `npm run tauri:build` uses:
#   src-tauri/.updater-keys/poc-desktop-tauri.key
#
# For CI / release machines:
# TAURI_SIGNING_PRIVATE_KEY=<contents of poc-desktop-tauri.key>
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
